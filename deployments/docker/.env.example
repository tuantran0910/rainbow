ENV=production

# Postgres Configurations
DB_HOST=postgres
DB_USER=root
DB_PASSWORD=root
DB_PORT=5432

AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

CDC_DB_USER=cdc
CDC_DB_PASSWORD=Cdc2024!Data

# Airflow Configurations
AIRFLOW_USER=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_PROJ_DIR=../../src/airflow
AIRFLOW_UID=50000

# API Configurations
API_DB_USER=rainbow
API_DB_PASSWORD=R&inb0w2024!Data
API_DB_NAME=rainbow

SERVER_PORT=5000
MAX_IDLE_CONNS=10
MAX_OPEN_CONNS=20
CONN_MAX_LIFETIME=1h

SERVER_NAME=rainbow-api
SERVER_VERSION=1.0.0
LOG_LEVEL=debug
ENABLE_CONSOLE=true

# Database Migrations
GOOSE_DRIVER=postgres
GOOSE_DBSTRING="host=localhost user=${API_DB_USER} password=${API_DB_PASSWORD} dbname=${API_DB_NAME} sslmode=disable"
GOOSE_MIGRATION_DIR=./migrations

