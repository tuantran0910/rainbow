Project rainbow {
  database_type: 'PostgreSQL'
  Note: 'Relational Database for Rainbow Data Platform'
}

Table users {
  id uuid [primary key]
  email varchar(100) [unique, not null]
  password varchar(255) [not null]
  first_name varchar(50)
  last_name varchar(50)
  last_login timestamp [default: null]
  is_active bool [default: true]
  phone_number varchar(20)
  role varchar(20) [default: 'user', note: 'user, admin']
  created_at timestamp [default: `current_timestamp`]
  updated_at timestamp [default: `current_timestamp`]
  deleted_at timestamp [default: null]
}

Table authors {
  id uuid [primary key]
  name varchar(100) [not null]
  slug varchar(100) [unique, not null]
  created_at timestamp [default: `current_timestamp`]
  updated_at timestamp [default: `current_timestamp`]
  deleted_at timestamp [default: null]
}

Table sellers {
  id uuid [primary key]
  user_id uuid [ref: > users.id, unique, null]
  name varchar(100) [not null]
  link varchar(255) [unique, not null]
  logo varchar(255)
  created_at timestamp [default: `current_timestamp`]
  updated_at timestamp [default: `current_timestamp`]
  deleted_at timestamp [default: null]
}

Table categories {
  id uuid [primary key]
  name varchar(100) [not null]
  slug varchar(100) [unique, not null]
  created_at timestamp [default: `current_timestamp`]
  updated_at timestamp [default: `current_timestamp`]
  deleted_at timestamp [default: null]
}

Table books {
  id uuid [pk]
  secondary_id varchar(100) [unique]
  category_id uuid [ref: > categories.id, not null]
  seller_id uuid [ref: > sellers.id, not null]
  name varchar(255) [not null]
  description text
  price decimal(10, 2) [not null]
  original_price decimal(10, 2) [not null]
  rating_average decimal(2, 1) [not null, default: 0.0, note: 'rating between 0 and 5']
  review_count int [default: 0]
  page_count integer
  created_at timestamp [default: `current_timestamp`]
  updated_at timestamp [default: `current_timestamp`]
  deleted_at timestamp [default: null]
}

Table book_authors {
  id uuid [pk]
  book_id uuid [ref: > books.id, pk]
  author_id uuid [ref: > authors.id, pk]
  created_at timestamp [default: `current_timestamp`]
  updated_at timestamp [default: `current_timestamp`]
  deleted_at timestamp [default: null]
}

Table payments {
  id uuid [pk]
  order_id uuid [ref: > orders.id, not null, unique]
  method varchar(20) [not null]
  amount decimal(10,2) [not null]
  created_at timestamp [default: `current_timestamp`]
  updated_at timestamp [default: `current_timestamp`]
  deleted_at timestamp [default: null]
}

enum order_status {
  pending
  processing
  shipped
  delivered
  cancelled
}

Table orders {
  id uuid [pk]
  user_id uuid [ref: > users.id, not null]
  status order_status [not null]
  shipping_address text [not null]
  created_at timestamp [default: `current_timestamp`]
  updated_at timestamp [default: `current_timestamp`]
  deleted_at timestamp [default: null]
}

Table order_items {
  id uuid [pk]
  order_id uuid [ref: > orders.id, not null]
  book_id uuid [ref: > books.id, not null]
  quantity int [not null, note: 'CHECK (quantity > 0)']
  unit_price decimal(10, 2) [not null]
  discount decimal(10, 2) [default: 0.00]
  created_at timestamp [default: `current_timestamp`]
  updated_at timestamp [default: `current_timestamp`]
  deleted_at timestamp [default: null]
}

Table inventories {
  id uuid [pk]
  book_id uuid [ref: > books.id, unique, not null]
  stock int [default: 1000]
  last_restocked_at timestamp
  created_at timestamp [default: `current_timestamp`]
  updated_at timestamp [default: `current_timestamp`]
  deleted_at timestamp [default: null]
}

Table book_reviews {
  id uuid [pk]
  book_id uuid [ref: > books.id, not null]
  user_id uuid [ref: > users.id, not null]
  rating int [default: 5, note: 'rating between 1 and 5']
  likes_count int [default: 0]
  created_at timestamp [default: `current_timestamp`]
  updated_at timestamp [default: `current_timestamp`]
  deleted_at timestamp [default: null]
  indexes {
    (user_id, book_id) [unique]
  }
}

enum promotion_discount_type {
  percentage
  fixed
}

Table promotions {
  id uuid [pk]
  name varchar(100) [not null]
  discount_type promotion_discount_type [not null]
  discount_value decimal(10,2) [not null, note: 'discount_value must be larger than 0']
  start_date timestamp [not null]
  end_date timestamp [not null, note: 'end_date must be larger than start_date']
  max_uses int
  used_count int [default: 0]
  created_at timestamp [default: `current_timestamp`]
  updated_at timestamp [default: `current_timestamp`]
  deleted_at timestamp [default: null]
}

Table promotion_applies_to {
  id uuid [pk]
  book_id uuid [ref: > books.id, not null]
  promotion_id uuid [ref: > promotions.id, not null]
  apply_to_all bool [default: false]
  created_at timestamp [default: `current_timestamp`]
  updated_at timestamp [default: `current_timestamp`]
  deleted_at timestamp [default: null]
  indexes {
    (book_id, promotion_id) [unique]
  }
}

Table user_wishlist {
  id uuid [pk]
  user_id uuid [ref: > users.id, not null]
  book_id uuid [ref: > books.id, not null]
  created_at timestamp [default: `current_timestamp`]
  updated_at timestamp [default: `current_timestamp`]
  deleted_at timestamp [default: null]
  indexes {
    (user_id, book_id) [unique]
  }
}
